{
  "name": "jswallet",
  "productName": "jswallet",
  "version": "1.0.0",
  "private": true,
  "description": "A sample Bitcoin wallet",
  "main": ".vite/build/index.cjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge release",
    "lint": "eslint --cache --color --ext .jsx,.js src",
    "test": "vitest run",
    "check": "npm test"
  },
  "keywords": [],
  "author": "mmichailidis",
  "license": "MIT",
  "dependencies": {
    "antd": "^3.2.0",
    "axios": "^0.18.0",
    "bip39": "^2.5.0",
    "bitcoinjs-lib": "^3.3.2",
    "blockchain.info": "^2.11.0",
    "bs58": "^4.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "events": "^3.3.0",
    "nedb": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^1.0.0-beta.10"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-devtools-installer": "^4.0.0",
    "eslint": ">=4.18.2",
    "eslint-config-airbnb": "^15",
    "eslint-plugin-import": "^2",
    "eslint-plugin-jsx-a11y": "^5",
    "eslint-plugin-react": "^7",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "antd": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "recharts": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "eslint-config-airbnb": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
